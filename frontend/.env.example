# Redora — public access via free ngrok tunnels.
#
# Copy this to `.env` after starting the tunnels (or run start-tunnels.ps1
# which writes it for you). Use the ngrok backend URL for both lines.
#
#   VITE_API_URL=https://xxxx.ngrok-free.app
#   VITE_SOCKET_URL=https://xxxx.ngrok-free.app
#
# These are baked in at build time, so restart the dev server after editing.
VITE_API_URL=
VITE_SOCKET_URL=